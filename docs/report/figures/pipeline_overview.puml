@startuml
!theme plain
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 10

rectangle "Binary\nMask" as input #F5CBA7
rectangle "(optional) Closing +\nHole Filling" as preproc #F9E79F
rectangle "Lee94\nThinning" as thin #85C1E9
rectangle "(optional) Junction\nCleanup" as clean #D7BDE2
rectangle "Graph\n(via Skan)" as graph #85C1E9
rectangle "Feature\nExtraction" as fex #A9DFBF

input -right-> preproc
preproc -right-> thin : cleaned
thin -right-> clean : skeleton
clean --> graph
graph -left-> fex : CSR graph

rectangle "Per-Image" as img #A9DFBF
rectangle "Per-Branch" as branch #A9DFBF
rectangle "Per-Node" as node #A9DFBF

fex -left-> img
fex --> branch
fex --> node

@enduml
